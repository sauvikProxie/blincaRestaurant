# Copy to .env and fill in. Both URLs come from the Convex backend
# (Blinca backend repo, packages/backend/.env.local after `bun run dev`).

# Convex deployment: queries, mutations and live updates (websocket).
PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Convex HTTP actions: Better Auth sign-in lives under /api/auth here.
PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Shows the "Simulate order" button. The backend only allows it on local
# deployments or where ALLOW_DEV_TOOLS=true is set.
PUBLIC_DEV_TOOLS=true
