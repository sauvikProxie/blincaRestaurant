{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.convex.site/api/auth/*" },
        { "url": "http://127.0.0.1:*/api/auth/*" },
        { "url": "http://localhost:*/api/auth/*" }
      ]
    }
  ]
}
